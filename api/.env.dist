DB_PASSWORD=spider_Db!2026
DB_DATABASE=pro_spider_app_db
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

APP_EXPOSE_PORT=8012
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3010

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# First-boot admin (created once when the users table is empty)
ADMIN_EMAIL=admin@missiria.dev
