# Google Search Console (ADR-0002): base64 of the service-account JSON key.
# Leave empty and keep GSC_MOCK=1 to work from api/fixtures/gsc without credentials.
GSC_SERVICE_ACCOUNT_JSON=
GSC_MOCK=1

# SMTP (unused in MVP-1)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=false
SMTP_EHLO_DOMAIN=localhost
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Support Client"
