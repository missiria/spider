APP_EXPOSE_PORT=8090
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=missiria
DB_PASSWORD=replace-with-a-strong-password
DB_DATABASE=pro_spider_app_db
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://spider.missiria.dev

# First-boot admin (created once when the users table is empty)
ADMIN_EMAIL=admin@missiria.dev
ADMIN_PASSWORD=replace-with-a-strong-password

# Google Search Console (ADR-0002): base64 of the service-account JSON key
# `base64 -i key.json | tr -d '\n'`
GSC_SERVICE_ACCOUNT_JSON=
# 1 = serve fixtures from api/fixtures/gsc instead of calling Google
GSC_MOCK=0

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=false
SMTP_EHLO_DOMAIN=localhost
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Support Client"
