PORT=8091
HOSTNAME=127.0.0.1

# Used by Next.js rewrites on the server. Browser requests stay
# same-origin through /api in production.
API_URL=http://127.0.0.1:8090

# Same value as the API: authenticates the client-IP header the web server forwards on login
INTERNAL_PROXY_SECRET=replace-with-a-long-random-secret
